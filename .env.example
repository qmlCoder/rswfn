# 阿里云 OSS 凭据模板 —— 复制成 .env 后填入真实值：
#
#     cp .env.example .env
#
# .env 已在 .gitignore 中，不会被提交。用途：
#   1) 本地把发布资产镜像到 OSS：
#        gh release download v0.1.3 --dir dist-oss --clobber
#        python .github/scripts/upload_oss.py v0.1.3 dist-oss
#   2) 一次性同步到 GitHub Actions 的仓库 secrets（release workflow 用）：
#        gh secret set -f .env --repo qmlCoder/rswfn
#
# upload_oss.py 会按 “进程环境变量 > 仓库根 .env” 的顺序取值，
# 所以 CI 里没有 .env 也没关系，值来自 secrets。

# 必填：RAM 子账号的 AccessKey（建议只授 oss:PutObject 到 wmview/rswfn/*）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# bucket 所在 region 的 endpoint
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 可选（默认值如下）：bucket 名与 key 前缀
OSS_BUCKET=wmview
OSS_PREFIX=rswfn
